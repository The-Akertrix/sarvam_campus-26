# Required only for real audio previews from Sarvam AI.
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh

# Howrah station defaults
STATION_CODE=HWH
STATION_NAME=Howrah Junction
STATION_TIMEZONE=Asia/Kolkata
PREFERRED_LANGUAGES=bn-IN,hi-IN,en-IN
POLL_INTERVAL_SECONDS=3

# Optional override when running dashboard and API on different hosts.
API_BASE_URL=http://127.0.0.1:8000
